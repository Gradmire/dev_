# ---------------------------------------------------------------
# Supabase — Project Settings > API
#
# Optional. Without these the public site runs normally and /login,
# /portal and /admin are closed. See README "Auth is optional".
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Server-only. Bypasses row-level security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---------------------------------------------------------------
# Postgres — Project Settings > Database > Connection string
# ---------------------------------------------------------------
# Required.
#
# Pooled (Supavisor, transaction mode, port 6543). Used by the running app.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Direct (port 5432). Used by drizzle-kit for migrations only.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Do NOT add ?sslmode=... to either URL. TLS is configured in code
# (src/db/index.ts), which pins Supabase's root CA and verifies the
# certificate. A driver option beats the connection string in postgres-js, so
# an sslmode here would be silently ignored — and would misleadingly suggest
# the weaker, unverified `require` mode was in force when it is not.
#
# Escape hatch only, for a rotated Supabase root CA or a non-Supabase host:
#   require  — encrypted, certificate NOT verified. Logs a warning. Temporary.
#   disable  — no TLS. Local Postgres only; throws if NODE_ENV=production.
# DATABASE_SSL_MODE=""

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Where new consultation enquiries are emailed.
LEADS_NOTIFICATION_EMAIL="hello@gradmire.com"

# ---------------------------------------------------------------
# DPDP compliance
# ---------------------------------------------------------------
# Transactional email. Without it the parental consent flow cannot send its
# link, and the action reports the failure rather than claiming success.
RESEND_API_KEY=""
EMAIL_FROM="Gradmire <no-reply@gradmire.com>"

# Salt for the one-way codes that replace an email address on rows retained
# after an erasure. Without it those rows are still unlinked, but a list of
# candidate addresses could be hashed against them. Any long random string.
DPDP_PSEUDONYM_SALT=""

# Authorises the nightly retention purge at /api/cron/purge. Vercel sends it
# as `Authorization: Bearer <secret>`. Without it the endpoint refuses every
# request, so retention silently stops being enforced — set it.
CRON_SECRET=""

# Published under s.13(3). Falls back to a role address, never a placeholder.
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME="The Grievance Officer"
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL="privacy@gradmire.com"
